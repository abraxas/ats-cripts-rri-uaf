# Shared ATS 10.2.0 lab image. Pin b1df7334. ENABLE_CRIPTS=ON.
FROM ubuntu:24.04 AS build

ENV DEBIAN_FRONTEND=noninteractive \
    CMAKE_BUILD_PARALLEL_LEVEL=2

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        cmake \
        g++ \
        libbrotli-dev \
        libcap-dev \
        libfmt-dev \
        libhwloc-dev \
        libluajit-5.1-dev \
        libmagick++-dev \
        libpcre2-dev \
        libpcre3-dev \
        libssl-dev \
        libxml2-dev \
        libzstd-dev \
        ninja-build \
        pkg-config \
        python3 \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src

RUN cmake -S /src -B /build -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/opt/ats \
        -DBUILD_TESTING=OFF \
        -DBUILD_REGRESSION_TESTING=OFF \
        -DENABLE_AUTEST=OFF \
        -DENABLE_DOCS=OFF \
        -DENABLE_EXAMPLE=OFF \
        -DENABLE_QUICHE=OFF \
        -DENABLE_VERIFY_PLUGINS=OFF \
        -DENABLE_CRIPTS=ON \
        -DENABLE_LUAJIT=ON \
        -DLUAJIT=ON \
        -DBUILD_EXPERIMENTAL_PLUGINS=ON \
        -DMAGICK=ON \
        -DENABLE_JEMALLOC=OFF \
        -DENABLE_ASAN=OFF \
        -DCMAKE_COMPILE_WARNING_AS_ERROR=OFF \
    && cmake --build /build --parallel 2 \
    && cmake --install /build \
    && test -f /opt/ats/lib/libcripts.so \
    && test -x /opt/ats/bin/traffic_server

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    ATS_ROOT=/opt/ats \
    PATH="/opt/ats/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/ats/lib"

LABEL lab=ats-10.2.0-lab

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libbrotli1 \
        libcap2 \
        libfmt9 \
        libgomp1 \
        libhwloc15 \
        libluajit-5.1-2 \
        libmagick++-6.q16-9t64 \
        libpcre2-8-0 \
        libpcre3 \
        libssl3t64 \
        libxml2 \
        libzstd1 \
        zlib1g \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/ats /opt/ats
COPY plugins/experimental/magick/keys/rsa256-public.key \
    /opt/ats/etc/trafficserver/rsa256-public.key

RUN mkdir -p /opt/ats/var/trafficserver /opt/ats/var/log/trafficserver /tmp/oracle \
    && chown -R nobody:nogroup /opt/ats/var /tmp/oracle \
    && chmod 1777 /tmp/oracle \
    && test -f /opt/ats/lib/libcripts.so \
    && test -f /opt/ats/libexec/trafficserver/magick.so

WORKDIR /opt/ats
EXPOSE 8080
CMD ["traffic_server"]
