# CONTROL: post-remap Client::URL only. Process must stay up.
map http://ats-control/ http://origin:8080/ @plugin=control.cript

# POC: post-remap Remap::From / Remap::To. Stack RRI is dead after DoRemap.
map http://ats-poc/ http://origin:8080/ @plugin=poc.cript

# No-plugin liveness probe.
map http://ats-health/ http://origin:8080/
